<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.shortlink</groupId>
    <artifactId>shortlink-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>shortlink-parent</name>
    <description>
        Parent POM for the ShortLink microservices project. Every service
        module inherits Java/Spring Boot version and shared build config
        from here, so bumping a version happens in one place instead of
        once per service.
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!--
        Add each new service here as it's built. Maven's reactor uses this
        list to know what to build, in what order (based on inter-module
        dependencies, though these services currently have none between
        them at the Maven level — they only talk to each other over
        HTTP/Kafka at runtime).
    -->
    <modules>
        <module>url-service</module>
    </modules>

</project>
