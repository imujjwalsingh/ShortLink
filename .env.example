# Copy to .env (git-ignored) and docker compose picks these up automatically.
# Generate secrets with e.g.:  openssl rand -base64 48

# HS256 signing key shared by auth-service (signs) and url/analytics/auth
# (verify). Must be at least 32 bytes.
JWT_SECRET=

# HMAC key for unique-visitor hashing in url-service.
VISITOR_HASH_KEY=

# Comma-separated origins allowed to call /api/** from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Host ports (only change if something on your machine already uses them,
# e.g. a locally installed MongoDB on 27017).
# GATEWAY_HOST_PORT=8080
# MONGO_HOST_PORT=27017
# REDIS_HOST_PORT=6379
# KAFKA_HOST_PORT=9092
# ES_HOST_PORT=9200
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
